# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://localhost:5432/fintech_agent


# --- Chat agent LLM: DeepSeek (demo phase; OpenAI-compatible API) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# --- Cloudinary (media & documents: receipts) ---
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
CLOUDINARY_FOLDER=fintech_agent

# --- External endpoint (AUXO Accountant API) ---
# These seed the sync configuration on a database that has none (first boot
# of a fresh deploy). Once stored, Configuración in the panel is the source of
# truth and the env is ignored for that key.
EXTERNAL_API_URL=https://api-dev.mandioca.global/api/v1/accountant/
EXTERNAL_API_KEY=
# bearer (Authorization: Bearer <token>) | api-key (Authorization: Api-Key <key>)
EXTERNAL_API_AUTH_SCHEME=api-key
# Feed paths relative to the base URL, comma-separated (one feed per path).
EXTERNAL_API_ORDERS_PATHS=order-payout/
EXTERNAL_API_EXPENSES_PATHS=
# Currency stamped on records that do not carry one.
EXTERNAL_API_DEFAULT_CURRENCY=USD
# Fixed field mapping (JSON, our field -> feed field). Pins the mapping the
# intake decided locally so every deploy imports the feed the same way.
EXTERNAL_API_ORDERS_MAPPING={"external_id": "pid", "customer": "legal_name", "amount": "amount_in", "currency": "currency_in", "status": "status", "date": "created_at"}
EXTERNAL_API_EXPENSES_MAPPING=

# --- Periodic pull (GET against the endpoint above) ---
# true: the app pulls on boot and then every SYNC_INTERVAL_SECONDS (15-3600).
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=3600
# Seconds after boot before the first pull.
SYNC_FIRST_PULL_SECONDS=10

# --- FX rates for USD-equivalent consolidation ---
FX_COP_PER_USD=4000
FX_MXN_PER_USD=18
# Dollar-pegged stablecoins count in USD totals at their peg (1 by default).
FX_USDT_PER_USD=1
FX_USDC_PER_USD=1

# --- CORS: allowed frontend origins ---
# In production add the Vercel domain, e.g. https://fintech.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Optional regex for origins that change per deploy (Vercel previews).
CORS_ORIGIN_REGEX=

# --- Public URL used to build links to locally stored PDFs ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Identity printed on generated PDFs ---
COMPANY_NAME=Mandioca
COMPANY_TAX_ID=

# --- Optional: map the external endpoint payload onto our fields ---
# EXTERNAL_FIELD_MAP={"orders": {"customer": ["payer_name"], "amount": ["total_cents"]}}

# --- Autenticación (JWT) ---
# Firma de los access tokens. Si falta, se genera uno al azar en cada arranque
# y todas las sesiones se caen al reiniciar.
JWT_SECRET=cambiá-esto-por-un-secreto-largo
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Primera cuenta, creada solo si la base no tiene usuarios.
ADMIN_EMAIL=santiago@elhub.co
ADMIN_NAME=Santiago
# Sin ADMIN_PASSWORD se genera una y se imprime una vez en el arranque.
# ADMIN_PASSWORD=

# --- Datos de demostración ---
# true: con la base vacía se carga el mock determinista (mayo-julio 2026).
# false: la base vacía se queda vacía — para trabajar con datos reales.
SEED_DEMO=false
